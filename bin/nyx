#!/usr/bin/env bash
# nyx: install, update and remove Nyx apps.
#
#   nyx list                   the apps, and which are installed
#   nyx install APP… | all     install apps (pass --default to open their files)
#   nyx update                 rebuild every installed app from the latest source
#   nyx uninstall APP… [--purge]
set -euo pipefail

REPO="design-nexus/nyx"
RAW="https://raw.githubusercontent.com/$REPO/main"
ALL=(settings contacts tasks torrents pdf notepad music media-player theater chat fonts archive office photos glimpse store git passwords weather news capture pulse containers files cloud notes calculator home maps transfer mail calendar reminders)
bin="$HOME/.local/bin"

# The program that shows an app is installed.
program() {
  case $1 in
    office) echo nyx-office ;;
    photos) echo nyx-photos ;;
    cloud) echo nyx-cloudd ;;
    *) echo "nyx-$1" ;;
  esac
}

installed() {
  for a in "${ALL[@]}" assistant; do [[ -x $bin/$(program "$a") ]] && echo "$a"; done
}

run() {
  local script=$1
  shift
  curl -fsSL "$RAW/$script" | bash -s -- "$@"
}

case ${1:-} in
  dev | release)
    here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    tooling="$here/../tools/suite.py"
    if [[ ! -f $tooling ]]; then
      tooling="${XDG_DATA_HOME:-$HOME/.local/share}/nyx/dev/suite.py"
    fi
    if [[ ! -f $tooling ]]; then
      suite_home="${XDG_DATA_HOME:-$HOME/.local/share}/nyx/development"
      [[ -e $suite_home ]] || git clone "https://github.com/$REPO.git" "$suite_home"
      tooling="$suite_home/tools/suite.py"
    fi
    exec python3 "$tooling" "$@" ;;
  list)
    for a in "${ALL[@]}"; do
      if [[ -x $bin/$(program "$a") ]]; then printf '  %-13s installed\n' "$a"; else printf '  %s\n' "$a"; fi
    done ;;
  install) shift; run install.sh "$@" ;;
  update)
    mapfile -t apps < <(installed)
    ((${#apps[@]})) || { echo "No Nyx apps are installed."; exit 0; }
    run install.sh "${apps[@]}" ;;
  uninstall | remove) shift; run uninstall.sh "$@" ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
